<UserControl x:Class="PraksaClient.Views.BoxSortView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:local="clr-namespace:PraksaClient.Views"
             xmlns:viewModels="clr-namespace:PraksaClient.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:BoxSortViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ListBox ItemsSource="{Binding Boxes}" Grid.Row="0" Grid.Column="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="H: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Height}" Margin="5,0,0,0"/>
                        <TextBlock Text="L: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Length}" Margin="5,0,0,0"/>
                        <TextBlock Text="W: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Width}" Margin="5,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding SortedBoxes}" Grid.Row="0" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="H: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Height}" Margin="5,0,0,0"/>
                        <TextBlock Text="L: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Length}" Margin="5,0,0,0"/>
                        <TextBlock Text="W: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Width}" Margin="5,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--
        <ListBox ItemsSource="{Binding TallestBoxes}" Grid.Row="0" Grid.Column="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="H: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Height}" Margin="5,0,0,0"/>
                        <TextBlock Text="L: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Length}" Margin="5,0,0,0"/>
                        <TextBlock Text="W: " FontWeight="Bold" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Width}" Margin="5,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
           -->

        <ItemsControl ItemsSource="{Binding MinHeap}" Grid.Column="2" Grid.Row="0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="H: " FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding Height}" Margin="5,0,0,0"/>
                                        <TextBlock Text="L: " FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding Length}" Margin="5,0,0,0"/>
                                        <TextBlock Text="W: " FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding Width}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="3">
            <Button Content="Generate" Command="{Binding GenerateBoxesCommand}" Margin="5" Width="150" ToolTip="Geerates new list of Boxes"/>
            <Button Content="Sort" Command="{Binding SortBoxesCommand}" Width="150" Margin="5" ToolTip="Sort list of Boxes"/>
            <Button Content="Find Tallest" Command="{Binding TallestBoxesCommand}" Width="150" Margin="5" ToolTip="Sort list of Boxes"/>
        </StackPanel>
    </Grid>
</UserControl>
