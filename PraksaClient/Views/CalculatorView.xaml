<UserControl x:Class="PraksaClient.Views.CalculatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PraksaClient.Views"
        mc:Ignorable="d" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Output -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="5"
          BorderBrush="Black" BorderThickness="2" Margin="0,0,0,87" Grid.RowSpan="2">
            <TextBlock Text="{Binding Output}" Margin="5" 
               FontFamily="Courier New" FontSize="24"/>
        </GroupBox>
        <!-- 1 -->
        <GroupBox Grid.Row="3">
            <Button Width="130" Content="1" CommandParameter="1" Command="{Binding GenerateCommand1}"
                HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 2 -->
        <GroupBox Grid.Row="3" Grid.Column="1">
            <Button Width="130" Content="2" CommandParameter="2" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 3 -->
        <GroupBox Grid.Row="3" Grid.Column="2">
            <Button Width="130" Content="3" CommandParameter="3" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 4 -->
        <GroupBox Grid.Row="2">
            <Button Width="130" Content="4" CommandParameter="4" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 5 -->
        <GroupBox Grid.Row="2" Grid.Column="1">
            <Button Width="130" Content="5" CommandParameter="5" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 6 -->
        <GroupBox Grid.Row="2" Grid.Column="2">
            <Button Width="130" Content="6" CommandParameter="6" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 7 -->
        <GroupBox Grid.Row="1" Margin="0,0,0,1">
            <Button Width="130" Content="7" CommandParameter="7" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 8 -->
        <GroupBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,1">
            <Button Width="130" Content="8" CommandParameter="8" Command="{Binding GenerateCommand1}"
        HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 9 -->
        <GroupBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,1">
            <Button Width="130" Content="9" CommandParameter="9" Command="{Binding GenerateCommand1}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- 0 -->
        <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,87,0,0" Grid.RowSpan="2">
            <Button Width="290" Content="0"  CommandParameter="0" Command="{Binding GenerateCommand1}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- . -->
        <GroupBox Grid.Row="3" Grid.Column="2" Margin="0,87,0,0" Grid.RowSpan="2">
            <Button Width="130" Content="." Command="{Binding GenerateCommandt}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- / -->
        <GroupBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,1">
            <Button Width="130" Content="/" CommandParameter="/" Command="{Binding GenerateCommandp}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- * -->
        <GroupBox Grid.Row="2" Grid.Column="3">
            <Button Width="130" Content="*" CommandParameter="*" Command="{Binding GenerateCommandp}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- - -->
        <GroupBox Grid.Row="3" Grid.Column="3">
            <Button Width="130" Content="-" CommandParameter="-" Command="{Binding GenerateCommandp}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- + -->
        <GroupBox Grid.Row="4" Grid.Column="3">
            <Button Width="130" Content="+" CommandParameter="+" Command="{Binding GenerateCommandp}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="75" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- C -->
        <GroupBox Grid.Row="1" Grid.Column="5" Grid.RowSpan="2">
            <Button Width="130" Content="C" Command="{Binding GenerateCommandC}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="160" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
        <!-- = -->
        <GroupBox Grid.Row="3" Grid.Column="5" Grid.RowSpan="2">
            <Button Width="130" Content="=" Command="{Binding GenerateCommandj}"
HorizontalAlignment="Left" Margin="10,0,0,0" Height="160" RenderTransformOrigin="0.475,0.611" />
        </GroupBox>
    </Grid>
</UserControl>
