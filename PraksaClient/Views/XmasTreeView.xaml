<UserControl x:Class="PraksaClient.Views.XmasTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PraksaClient.Views"
             xmlns:viewModels="clr-namespace:PraksaClient.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewModels:XMasTreeViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Input" Grid.Row="0" Grid.Column="0"
                  BorderBrush="Black" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Header:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                <Label Content="Footer:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                <Label Content="Height:" Grid.Row="2" Grid.Column="0" Margin="5"/>

                <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="0" Grid.Column="1" Margin="5" TextAlignment="Right"/>

                <TextBox Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="1" Grid.Column="1" Margin="5" TextAlignment="Right"/>
                
                <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="2" Grid.Column="1" Margin="5" TextAlignment="Right"/>

            </Grid>
        </GroupBox>

        <GroupBox Header="Output" Grid.Row="0" Grid.Column="1" 
                  BorderBrush="Black" BorderThickness="3">
            <TextBlock Text="{Binding Output}" Margin="5" 
                       FontFamily="Courier New" FontSize="24" Foreground="{Binding Olovka}"/>
        </GroupBox>

        <GroupBox Header="Commands" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                  BorderBrush="Black" BorderThickness="3">
            <StackPanel Orientation="Horizontal">
                <Button Content="Generate" Command="{Binding GenerateCommand}"
                    Width="150" HorizontalAlignment="Left" Margin="10, 5, 5 ,5" />
                <Button Content="On" Command="{Binding OnOffCommand}"
                            Width="150" HorizontalAlignment="Left" Margin="10, 5, 5 ,5" />
            </StackPanel>
        </GroupBox>

    </Grid>
</UserControl>
